# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# AnimeLib Configuration
ANIMELIB_API_URL="https://hapi.hentaicdn.org/api"
ANIMELIB_USER_ID="your_animelib_numeric_id"
ANIMELIB_COOKIE="Bearer your_access_token"

# Shikimori OAuth2 API
SHIKIMORI_CLIENT_ID="your_shikimori_client_id"
SHIKIMORI_CLIENT_SECRET="your_shikimori_client_secret"
SHIKIMORI_ACCESS_TOKEN="your_shikimori_access_token"
SHIKIMORI_REFRESH_TOKEN="your_shikimori_refresh_token"
SHIKIMORI_USER_ID="your_shikimori_numeric_id"
SHIKIMORI_USER_AGENT="Anime Tracker Hub (contact: your_email@example.com)"

# Optional local server settings
PORT=3000
DB_PATH=local.db

# Local Gemini -> GitHub bridge (never commit real values)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.8-flash"
GITHUB_PAT="your_fine_grained_github_token"
GITHUB_OWNER="your_github_login"
GITHUB_REPO="your_repository"
GITHUB_BRANCH="feat/ai-github-bridge"
