# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# .env НЕ добавляйте в git / нигде не публикуйте — там секреты.
# Этот файл — шаблон. Заменяйте все значения в `.env` на свои реальные параметры.
# Если `env.example` когда-либо содержал реальные секреты, смените эти пароли/ключи.

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_generate_your_own_secure_password
POSTGRES_DB=n8n

# --- n8n ---
# Домен, на который смотрит A-запись VPS (нужен только если планируете
# принимать вебхуки Telegram напрямую через Caddy/Nginx с TLS).
N8N_HOST=n8n.example.com
TZ=Europe/Warsaw

# Сгенерируйте один раз командой и сохраните в надёжном месте:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_to_a_random_hex_string
